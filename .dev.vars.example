# 本地开发用（wrangler dev 会读取 .dev.vars，生产环境必须使用 wrangler secret put）
# 复制为 .dev.vars 后填入真实值；.dev.vars 已在 .gitignore 中，不会被提交。
#
# 生成随机密钥：npm run gen-secret

GITHUB_CLIENT_ID=Ov23liXXXXXXXXXXXXXX
GITHUB_CLIENT_SECRET=replace_with_github_app_client_secret

# 用于加密 state Cookie（AES-256-GCM），一旦更换，所有进行中的登录会话失效
COOKIE_SECRET=replace_with_32_byte_random_string

# 用于对回传业务服务器的 JSON 报文做 HMAC-SHA256 签名
CALLBACK_SIGNING_SECRET=replace_with_32_byte_random_string
